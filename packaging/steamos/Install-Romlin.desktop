[Desktop Entry]
Type=Application
Name=Install Romlin
Comment=Download Romlin and add it to Steam
Exec=bash -c "set -e; work=\\$(mktemp -d); trap 'rm -rf \\"\\$work\\"' EXIT; if curl --fail --location --show-error --output \\"\\$work/install.py\\" https://raw.githubusercontent.com/romlin-emu/romlin/main/packaging/steamos/install.py; then python3 \\"\\$work/install.py\\"; else kdialog --title \\"Install Romlin\\" --error \\"Could not download the installer. Check your internet connection and try again.\\"; exit 1; fi"
Icon=applications-games
Terminal=false
