# Loaded by mise.toml on macOS only (a missing .mise/<os>.env is ignored elsewhere).
#
# libcubeb's CMake build skips its bundled speex resampler whenever pkg-config finds
# speexdsp, and cubeb-sys never links the library on macOS, so a Homebrew speexdsp
# breaks the final link with undefined _speex_resampler_* symbols. /var/empty is an
# empty system directory: with it as the only pkg-config library path, the bundled
# speex is always used and no Homebrew library is picked up.
#
# After changing these, rebuild the C dependency: cargo clean --release -p cubeb-sys
# (Cargo and mbx do not track these variables, so an old build output is reused).
PKG_CONFIG_LIBDIR=/var/empty
PKG_CONFIG_PATH=
# Matches LSMinimumSystemVersion in packaging/macos/Info.plist and rustc's aarch64 default.
MACOSX_DEPLOYMENT_TARGET=11.0
